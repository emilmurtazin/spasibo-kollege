# Скопируйте этот файл в .env и заполните своими значениями

# Django
SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=*

# База данных (PostgreSQL на Timeweb Cloud)
# Формат: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://spasibo_user:spasibo_password@localhost:5432/spasibo_db

# Telegram Bot
# Получить токен у @BotFather в Telegram
TELEGRAM_BOT_TOKEN=your-bot-token-here

# Username бота (без @)
TELEGRAM_BOT_USERNAME=spasibo_kollega_bot

# Секрет для верификации webhook (любая случайная строка)
TELEGRAM_WEBHOOK_SECRET=change-me-to-random-string

# Публичный URL сайта (используется в ссылках бота)
SITE_URL=https://www.24spasibo.ru
