# Скопируйте этот файл в .env и заполните своими значениями

# Django
SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=*

# База данных (PostgreSQL на Timeweb Cloud)
# Формат: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://spasibo_user:spasibo_password@localhost:5432/spasibo_db

# Telegram (опционально, для будущей интеграции бота)
TELEGRAM_BOT_TOKEN=
